# Local development: export these variables or use scripts/run-local.sh.
# Do not commit actual passwords.
PORT=8080
DATA_DIR=data
ADMIN_PASSWORD=12345
# Optional in local development; generated and persisted automatically if omitted.
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Production: provision these with scripts/bootstrap-gcloud.sh.
# APP_ENV=production
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE=svm-rakennus
# SITE_NAMESPACE=svm_rakennus_site
# STORAGE_BUCKET=your-project-svm-rakennus-media

# Email can be configured at any time.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=verified-sender@your-domain.fi
# MAIL_TO=owner@your-domain.fi
